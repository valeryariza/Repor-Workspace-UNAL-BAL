<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>
        <%= etiqueta %>
    </title>

    <%- include('Partials/head') %>
        <style>
        .oculto { display: none !important; }
        .paso-seccion { margin-top: 20px; }
    </style>

</head>

<body>
    <%- include('Partials/navegation') %>

        <main class="container d-flex flex-column justify-content-center align-items-center py-5">

            <div class="container mt-5 mb-5 p-5 bg-black rounded-4 shadow-lg" style="width: 100%; max-width: 600px;">
                <h1>Bienvenidos Vista de Creacion de Usuario</h1>
                <h2>Gestion de Usuario</h2>

                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/registro" method="POST" id="formRegistro">

                    <!--======= PASO 1 ======= -->
                    <div id="paso-1" class="paso-seccion">
                        <h4>1. datos personales (Identificacion)</h4>
                        <div class="mb-3">
                            <label>Tipo de Documento</label>
                            <select name="tipoDocumento" class="form-control" id="tipoDocumento" required>
                                <option value="CEDULA">CEDULA DE CIUDADANIA</option>
                                <option value="TI">TARJETA DE IDENTIDAD</option>
                                <option value="CE">CEDULA DE EXTRANJERIA</option>
                            </select>
                        </div>

                        <label>Numero de Documento</label>
                        <input type="text" name="numeroDocumento" class="form-control" id="numeroDocumento"
                            placeholder="Digite su Cedula" required>
                        <br>

                        <button type="button" class="btn btn-primary" onclick="siguientePaso(2)">
                            Continuar</button>
                    </div>

                    <!--======= PASO 2 ======= -->
                    <div id="paso-2" class="paso-seccion oculto">
                        <h4>2. datos personales y Nombres</h4>
                        <p class="text-info">Ingrese sus nombres y apellidos tal como aparecen en su documento de
                            identificacion</p>

                        <br>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>Primer Nombre</label>
                                <input type="text" name="primerNombre" class="form-control" id="primerNombre"
                                    placeholder="Digite su Primer Nombre" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label>Segundo Nombre</label>
                                <input type="text" name="segundoNombre" class="form-control" id="segundoNombre"
                                    placeholder="Digite su Segundo Nombre">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label>Primer Apellido</label>
                                <input type="text" name="primerApellido" class="form-control" id="primerApellido"
                                    placeholder="Digite su Primer Apellido" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label>Segundo Apellido</label>
                                <input type="text" name="segundoApellido" class="form-control" id="segundoApellido"
                                    placeholder="Digite su Segundo Apellido" required>
                            </div>
                        </div>

                        <br>

                        <div class="mb-5">
                            <label>Fecha de Nacimiento</label>
                            <input type="date" name="fechaNacimiento" class="form-control" id="fechaNacimiento"
                                max="<%= new Date().toISOString().split('T')[0] %>" required>
                        </div>

                        <button type="button" class="btn btn-secondary" onclick="siguientePaso(1)">Atras</button>
                        <button type="button" class="btn btn-primary" onclick="siguientePaso(3)">Continuar</button>

                    </div>

                    <!--======= PASO 3 ======= -->

                    <div id="paso-3" class="paso-seccion oculto">
                        <h4>3. Correo electronico</h4>
                        <div class="mb-3">
                            <label>Correo Electronico</label>
                            <input type="email" name="correo" class="form-control" id="correo" placeholder="correo@gmail.com"
                                required>
                        </div>

                        <div class="mb-3">
                            <label>Confirmar Correo Electronico</label>
                            <input type="email" name="confirmarCorreo" class="form-control" id="confirmarCorreo"
                                placeholder="Porfavor Confirmar correo electronico" required>
                        </div>
                    

                        <h4>Crear contraseña</h4>
                        <div class="mb-3">
                            <label>Contraseña</label>
                            <input type="password" name="contrasena" class="form-control" id="contrasena" placeholder="Digite su contraseña" required>
                        </div>

                        <div class="mb-3">
                            <label>Confirmar Contraseña</label>
                            <input type="password" name="confirmarContrasena" class="form-control" id="confirmarContrasena" placeholder="Porfavor Confirmar contraseña" required>
                        </div>
                        <button type="button" class="btn btn-secondary" onclick="pasoAnterior(2)">Atras</button>
                        <button type="submit" class="btn btn-success"> Finalizar Registro</button>

                    </div>
                </form>
            </div>
        </main>

        <%- include('Partials/footer') %>

        <script>
            const pasos = ['paso-1', 'paso-2', 'paso-3'];

            function siguientePaso(pasoDestino) {
                const pasoActualId = pasos.find(id => !document.getElementById(id).classList.contains('oculto'));
                const pasoActual = document.getElementById(pasoActualId);

                const camposRequeridos = pasoActual.querySelectorAll('[required]');
                for (const campo of camposRequeridos) {
                    if (!campo.checkValidity()) {
                        campo.reportValidity();
                        return;
                    }
                }

                cambiarPaso(pasoDestino);
            }

            function pasoAnterior(pasoDestino) {
                cambiarPaso(pasoDestino);
            }

            function cambiarPaso(pasoDestino) {
                pasos.forEach(id => document.getElementById(id).classList.add('oculto'));
                document.getElementById('paso-' + pasoDestino).classList.remove('oculto');
            }
        </script>
</body>

</html>