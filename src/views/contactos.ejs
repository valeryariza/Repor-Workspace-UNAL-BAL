<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> <%= etiqueta %> </title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <%- include('Partials/head') %>
</head>
<body>
    <%- include('Partials/navegation') %>
    <!-- Creacion de formulario -->
    <div class="container vh-100  d-flex justify-content-center align-items-center">
        <!-- Crea una targeta de Bootstraps para contener el formulario -->
        <div class="card  text-white text-center" style="background-color: #297029;">
            <!-- Se crea la cabecera de la tarjeta -->
            <div class="card-header">
                <h3 class="justify-contener align-items-center"> Formulario de Contacto </h3>
                <div class="card-body text-star">
                    <form>
                        <div class="mb-3">
                            <label for="Nombre"> Nombre </label>
                            <input type="text" placeholder="Nombre Completo" class="form-control">
                        </div>

                        <div class="mb-3">
                            <label for="email"> Correo Electronico </label>
                            <input type="text" placeholder="Correo" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label for="Nombre" class="form-label"> Asunto </label>
                            <select name="asunto" class="form-control" >
                                <option value="consulta"> Consulta </option>
                                <option value="sugerencia"> Sugerencia </option>
                                <option value="reclamo"> Reclamo </option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="Nombre" class="form-label"> Mensaje </label>
                            <textarea name="mensaje" rows="3" class="form-control" placeholder="Mensaje (Opcional)"></textarea>
                        </div>



                        <button type="submit">
                            Enviar
                        </button>

                        <button type="reset">
                            Limpiar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>